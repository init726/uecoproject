# Supabase 대시보드 > Project Settings > API 에서 복사해 .env.local 파일에 붙여넣는다.
# (.env.local 은 GitHub에 올라가지 않는다)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 관리자 전용 키 (Project Settings > API Keys > Secret key). 서버에서만 쓰인다.
# 모든 보안 규칙을 무시하는 키이므로 절대 NEXT_PUBLIC_ 을 붙이거나 GitHub에 올리지 말 것.
SUPABASE_SECRET_KEY=

# 문자 발송 (선택). 솔라피(solapi.com) 가입 → API Key 발급 → 발신번호 사전 등록 후 넣는다.
# 비워 두면 단체 발급 때 문자 없이 발급만 한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_SENDER=
